# Base URL of an external catalogue backend that serves the same /api routes as this site.
# Leave empty to read products from the database. Never point it at this site itself.
CATALOG_API_URL=

# Public address of the live site, used by the sitemap, robots.txt and share previews.
# Leave empty to use the workers.dev address.
SITE_URL=

# Neon Postgres connection string (use the pooled one). Leave empty locally to use the
# in-process database in .data/pglite, seeded with the demo catalogue.
DATABASE_URL=

# At least 32 random characters. Signs owner session tokens. Required in production.
SESSION_SECRET=

# The owner account is created from these on the first login, and only while no account exists.
# The password needs at least 10 characters.
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=
