{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shree-balaji",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "shree-balaji",
    },
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "shree-balaji-next-cache" },
    { "binding": "PHOTOS_BUCKET", "bucket_name": "shree-balaji-photos" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  // Keeps the Neon database awake by calling /api/health.
  "triggers": {
    "crons": ["*/3 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
